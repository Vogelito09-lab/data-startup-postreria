# Copia este archivo como .streamlit/secrets.toml (ya está en .gitignore) y llénalo.

[s3]
bucket = "data-startup-salome-TU-NOMBRE"
key = "clean/pedidos/pedidos_salome_clean.csv"
region = "us-east-1"

