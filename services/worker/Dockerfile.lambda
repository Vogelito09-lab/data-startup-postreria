# syntax=docker/dockerfile:1
# Imagen de la función Lambda del worker (E3). Se sube a ECR y Terraform la usa.
#   docker build --platform linux/amd64 -f services/worker/Dockerfile.lambda -t salome-worker-lambda .
FROM public.ecr.aws/lambda/python:3.13
COPY services/worker/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt && rm requirements.txt
COPY services/worker/limpieza.py services/worker/db.py services/worker/worker.py services/worker/lambda_handler.py ${LAMBDA_TASK_ROOT}/
COPY services/worker/referencia/ ${LAMBDA_TASK_ROOT}/referencia/
CMD ["lambda_handler.handler"]
